# MySQL/TiDB production connection for Vercel or any hosted database.
# Example: DATABASE_URL="mysql://user:password@host:3306/bugesera"
DATABASE_URL="mysql://user:password@host:3306/bugesera"

# Auth.js — generate with: npx auth secret
AUTH_SECRET="dev-secret-change-me"

# Public site URL (used in payment redirects)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cloudinary (image & document uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Payments — Flutterwave (supports MTN MoMo, Airtel Money, cards in Rwanda)
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_HASH=""

# First admin account created by the runtime seed/guard
ADMIN_EMAIL="admin@bugeserastoneworks.rw"
ADMIN_PASSWORD="change-me-now"
