/build
/dist

# Environment variables
.env
.env*.local
.env.production
.env.staging
.env.test
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime / diagnostic logs
.next/dev/logs/
*.log

# Deployment
.vercel

# Operating System files
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace
.idea/
.vscode/*
